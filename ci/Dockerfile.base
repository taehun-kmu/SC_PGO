FROM ros:humble-ros-base AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Pre-configure tzdata
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    gnupg \
    lsb-release \
    software-properties-common \
    sudo \
    git \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

FROM base

# Install dependencies
# Security fix: Removed curl-to-bash apt-fast installation, using standard apt instead
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    libpcl-dev \
    libpcap-dev \
    libopencv-dev \
    libceres-dev \
    libomp-dev \
    libeigen3-dev \
    ros-humble-cv-bridge \
    ros-humble-pcl-conversions \
    ros-humble-pcl-msgs \
    ros-humble-tf2 \
    ros-humble-tf2-ros \
    ros-humble-nav-msgs \
    ros-humble-sensor-msgs \
    ros-humble-geometry-msgs \
    ros-humble-std-msgs \
    ros-humble-image-transport \
    ros-humble-gtsam \
    && rm -rf /var/lib/apt/lists/*

# Build and install catch_ros2 for testing infrastructure
# Install to /opt/catch_ros2_ws as an overlay workspace
RUN mkdir -p /opt/catch_ros2_ws/src && \
    cd /opt/catch_ros2_ws/src && \
    git clone https://github.com/ngmor/catch_ros2.git && \
    cd /opt/catch_ros2_ws && \
    /bin/bash -c "source /opt/ros/humble/setup.bash && colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release --cmake-args -DBUILD_TESTING=OFF"

# Source catch_ros2 overlay in ROS setup
RUN echo "source /opt/catch_ros2_ws/install/setup.bash" >> /opt/ros/humble/setup.bash

WORKDIR /ros2_ws

# Verify tools
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && echo \$ROS_DISTRO && colcon version-check && ninja --version"
